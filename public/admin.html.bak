<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#4285f4">
  <title>QR Game - Administration</title>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <!-- Chart.js -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="css/admin.css">
  <link rel="icon" href="images/favicon.ico" type="image/x-icon">
</head>
<body>
  <!-- Login Container (initially hidden) -->
  <div id="login-container" style="display: none;">
    <!-- Login form will be dynamically generated by auth.js -->
  </div>

  <!-- Main Content -->
  <div class="main-content">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">
          <img id="navbar-logo" src="" alt="" style="display: none; height: 30px; margin-right: 10px;">
          QR Game Admin
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-user-circle me-1"></i>
                <span id="user-name">Administrateur</span>
              </a>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i><span id="user-email">admin@example.com</span></a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="#" id="logout-button"><i class="fas fa-sign-out-alt me-2"></i>Déconnexion</a></li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Main Container -->
    <div class="container-fluid">
      <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
          <div class="position-sticky pt-3">
            <ul class="nav flex-column">
              <li class="nav-item">
                <a class="nav-link active" data-section="dashboard" href="#">
                  <i class="fas fa-tachometer-alt me-2"></i>
                  Tableau de bord
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" data-section="questions" href="#">
                  <i class="fas fa-question-circle me-2"></i>
                  Questions
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" data-section="statistics" href="#">
                  <i class="fas fa-chart-bar me-2"></i>
                  Statistiques
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" data-section="export" href="#">
                  <i class="fas fa-file-export me-2"></i>
                  Exportation
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" data-section="settings" href="#">
                  <i class="fas fa-cog me-2"></i>
                  Paramètres
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
          <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2" id="page-title">Tableau de bord</h1>
          </div>

          <!-- Dashboard Section -->
          <section id="dashboard-section" class="content-section">
            <div class="row mb-4">
              <div class="col-md-3 mb-4">
                <div class="card bg-primary text-white h-100">
                  <div class="card-body py-5">
                    <h2 class="card-title h1 text-center" id="total-players">0</h2>
                    <p class="card-text text-center">Joueurs</p>
                  </div>
                </div>
              </div>
              <div class="col-md-3 mb-4">
                <div class="card bg-success text-white h-100">
                  <div class="card-body py-5">
                    <h2 class="card-title h1 text-center" id="total-games">0</h2>
                    <p class="card-text text-center">Parties</p>
                  </div>
                </div>
              </div>
              <div class="col-md-3 mb-4">
                <div class="card bg-warning text-white h-100">
                  <div class="card-body py-5">
                    <h2 class="card-title h1 text-center" id="completion-rate">0%</h2>
                    <p class="card-text text-center">Taux de complétion</p>
                  </div>
                </div>
              </div>
              <div class="col-md-3 mb-4">
                <div class="card bg-info text-white h-100">
                  <div class="card-body py-5">
                    <h2 class="card-title h1 text-center" id="avg-completion-time">00:00</h2>
                    <p class="card-text text-center">Temps moyen</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="row mb-4">
              <div class="col-md-6 mb-4">
                <div class="card h-100">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Activité récente</h5>
                  </div>
                  <div class="card-body">
                    <canvas id="activity-chart" height="250"></canvas>
                  </div>
                </div>
              </div>
              <div class="col-md-6 mb-4">
                <div class="card h-100">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Progression par défi</h5>
                  </div>
                  <div class="card-body">
                    <canvas id="challenge-chart" height="250"></canvas>
                  </div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-12">
                <div class="card">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Activité récente</h5>
                  </div>
                  <div class="card-body">
                    <div class="table-responsive">
                      <table class="table table-striped table-hover">
                        <thead>
                          <tr>
                            <th>Date</th>
                            <th>Joueur</th>
                            <th>Action</th>
                            <th>Défi</th>
                          </tr>
                        </thead>
                        <tbody id="recent-activity-list">
                          <!-- Populated dynamically -->
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Questions Section -->
          <section id="questions-section" class="content-section" style="display: none;">
            <div id="questions-list-container">
              <div class="row mb-4">
                <div class="col-12">
                  <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                      <h5 class="card-title mb-0">Liste des questions</h5>
                      <div>
                        <button id="add-question-button" class="btn btn-primary me-2">
                          <i class="fas fa-plus me-1"></i> Ajouter
                        </button>
                        <div class="btn-group">
                          <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-file-import me-1"></i> Importer/Exporter
                          </button>
                          <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                              <label for="import-questions" class="dropdown-item">
                                <i class="fas fa-file-import me-1"></i> Importer
                              </label>
                              <input type="file" id="import-questions" accept=".json,.csv" style="display: none;">
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#" id="export-questions-json"><i class="fas fa-file-export me-1"></i> Exporter (JSON)</a></li>
                            <li><a class="dropdown-item" href="#" id="export-questions-csv"><i class="fas fa-file-export me-1"></i> Exporter (CSV)</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#" id="generate-qr-codes"><i class="fas fa-qrcode me-1"></i> Générer QR codes</a></li>
                          </ul>
                        </div>
                      </div>
                    </div>
                    <div class="card-body">
                      <div class="table-responsive">
                        <table class="table table-striped table-hover">
                          <thead>
                            <tr>
                              <th>ID</th>
                              <th>Titre</th>
                              <th>Description</th>
                              <th>Type</th>
                              <th>Points</th>
                              <th>Actions</th>
                            </tr>
                          </thead>
                          <tbody id="questions-list">
                            <!-- Populated dynamically -->
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div id="question-form-container" style="display: none;">
              <div class="card">
                <div class="card-header">
                  <h5 class="card-title mb-0" id="question-form-title">Ajouter une question</h5>
                </div>
                <div class="card-body">
                  <form id="question-form">
                    <div class="row mb-3">
                      <div class="col-md-6">
                        <label for="question-id" class="form-label">ID</label>
                        <input type="text" class="form-control" id="question-id" required>
                      </div>
                      <div class="col-md-6">
                        <label for="question-type" class="form-label">Type</label>
                        <select class="form-select" id="question-type">
                          <option value="standard">Standard</option>
                          <option value="start">Début</option>
                          <option value="end">Fin</option>
                          <option value="question">Question</option>
                          <option value="challenge">Défi</option>
                        </select>
                      </div>
                    </div>
                    <div class="mb-3">
                      <label for="question-title" class="form-label">Titre</label>
                      <input type="text" class="form-control" id="question-title" required>
                    </div>
                    <div class="mb-3">
                      <label for="question-description" class="form-label">Description</label>
                      <textarea class="form-control" id="question-description" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                      <label for="question-points" class="form-label">Points</label>
                      <input type="number" class="form-control" id="question-points" min="0" value="10">
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Options</label>
                      <div id="options-container">
                        <!-- Options will be added here dynamically -->
                      </div>
                      <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="addOption()">
                        <i class="fas fa-plus me-1"></i> Ajouter une option
                      </button>
                    </div>
                    <div class="mb-3">
                      <label for="correct-answer" class="form-label">Réponse correcte (optionnel)</label>
                      <input type="text" class="form-control" id="correct-answer">
                    </div>
                    <div class="d-flex justify-content-end">
                      <button type="button" class="btn btn-secondary me-2" id="cancel-question-button">Annuler</button>
                      <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </section>

          <!-- Statistics Section -->
          <section id="statistics-section" class="content-section" style="display: none;">
            <div class="row mb-4">
              <div class="col-12">
                <div class="card">
                  <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Statistiques du jeu</h5>
                    <div>
                      <div class="input-group">
                        <select class="form-select" id="stats-period">
                          <option value="7days">7 derniers jours</option>
                          <option value="30days">30 derniers jours</option>
                          <option value="90days">90 derniers jours</option>
                          <option value="all">Tout</option>
                        </select>
                        <button class="btn btn-outline-secondary" type="button" id="refresh-stats">
                          <i class="fas fa-sync-alt"></i> Actualiser
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="row mb-4">
              <div class="col-md-6 mb-4">
                <div class="card h-100">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Joueurs par jour</h5>
                  </div>
                  <div class="card-body">
                    <canvas id="players-chart" height="250"></canvas>
                  </div>
                </div>
              </div>
              <div class="col-md-6 mb-4">
                <div class="card h-100">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Temps moyen par défi</h5>
                  </div>
                  <div class="card-body">
                    <canvas id="time-per-challenge-chart" height="250"></canvas>
                  </div>
                </div>
              </div>
            </div>

            <div class="row mb-4">
              <div class="col-md-6 mb-4">
                <div class="card h-100">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Taux de complétion</h5>
                  </div>
                  <div class="card-body">
                    <canvas id="completion-chart" height="250"></canvas>
                  </div>
                </div>
              </div>
              <div class="col-md-6 mb-4">
                <div class="card h-100">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Répartition des appareils</h5>
                  </div>
                  <div class="card-body">
                    <canvas id="devices-chart" height="250"></canvas>
                  </div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-12">
                <div class="card">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Top joueurs</h5>
                  </div>
                  <div class="card-body">
                    <div class="table-responsive">
                      <table class="table table-striped table-hover">
                        <thead>
                          <tr>
                            <th>Joueur</th>
                            <th>Parties complétées</th>
                            <th>Temps moyen</th>
                            <th>Dernière activité</th>
                          </tr>
                        </thead>
                        <tbody id="top-players-list">
                          <!-- Populated dynamically -->
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Export Section -->
          <section id="export-section" class="content-section" style="display: none;">
            <div class="row mb-4">
              <div class="col-md-6 mb-4">
                <div class="card h-100">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Exportation des données</h5>
                  </div>
                  <div class="card-body">
                    <h6 class="mb-3">Données des joueurs</h6>
                    <div class="d-flex mb-4">
                      <button id="export-players-json" class="btn btn-outline-primary me-2">
                        <i class="fas fa-file-export me-1"></i> Exporter en JSON
                      </button>
                      <button id="export-players-csv" class="btn btn-outline-primary">
                        <i class="fas fa-file-export me-1"></i> Exporter en CSV
                      </button>
                    </div>

                    <h6 class="mb-3">Questions</h6>
                    <div class="d-flex mb-4">
                      <button id="export-questions-json" class="btn btn-outline-primary me-2">
                        <i class="fas fa-file-export me-1"></i> Exporter en JSON
                      </button>
                      <button id="export-questions-csv" class="btn btn-outline-primary">
                        <i class="fas fa-file-export me-1"></i> Exporter en CSV
                      </button>
                    </div>

                    <h6 class="mb-3">Statistiques</h6>
                    <div class="d-flex">
                      <button id="export-stats-json" class="btn btn-outline-primary me-2">
                        <i class="fas fa-file-export me-1"></i> Exporter en JSON
                      </button>
                      <button id="export-stats-csv" class="btn btn-outline-primary">
                        <i class="fas fa-file-export me-1"></i> Exporter en CSV
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-md-6 mb-4">
                <div class="card h-100">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Exports programmés</h5>
                  </div>
                  <div class="card-body">
                    <form id="scheduled-export-form" class="mb-4">
                      <div class="mb-3">
                        <label for="export-email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="export-email" required>
                      </div>
                      <div class="mb-3">
                        <label for="export-frequency" class="form-label">Fréquence</label>
                        <select class="form-select" id="export-frequency">
                          <option value="daily">Quotidien</option>
                          <option value="weekly">Hebdomadaire</option>
                          <option value="monthly">Mensuel</option>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label for="export-format" class="form-label">Format</label>
                        <select class="form-select" id="export-format">
                          <option value="json">JSON</option>
                          <option value="csv">CSV</option>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label for="export-data-type" class="form-label">Type de données</label>
                        <select class="form-select" id="export-data-type">
                          <option value="players">Joueurs</option>
                          <option value="questions">Questions</option>
                          <option value="stats">Statistiques</option>
                          <option value="all">Toutes les données</option>
                        </select>
                      </div>
                      <button type="submit" class="btn btn-primary">
                        <i class="fas fa-calendar-alt me-1"></i> Programmer
                      </button>
                    </form>

                    <h6 class="mb-3">Exports programmés</h6>
                    <div class="table-responsive">
                      <table class="table table-striped table-hover">
                        <thead>
                          <tr>
                            <th>Email</th>
                            <th>Fréquence</th>
                            <th>Format</th>
                            <th>Type</th>
                            <th>Prochain export</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody id="scheduled-exports-list">
                          <!-- Populated dynamically -->
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Settings Section -->
          <section id="settings-section" class="content-section" style="display: none;">
            <div class="row">
              <div class="col-md-6 mb-4">
                <div class="card">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Paramètres généraux</h5>
                  </div>
                  <div class="card-body">
                    <form id="general-settings-form">
                      <div class="mb-3">
                        <label for="game-title" class="form-label">Titre du jeu</label>
                        <input type="text" class="form-control" id="game-title" placeholder="QR Game">
                      </div>
                      <div class="mb-3">
                        <label for="base-url" class="form-label">URL de base</label>
                        <input type="url" class="form-control" id="base-url" placeholder="https://example.com">
                      </div>
                      <div class="mb-3">
                        <label for="admin-email" class="form-label">Email de l'administrateur</label>
                        <input type="email" class="form-control" id="admin-email" placeholder="admin@example.com">
                      </div>
                      <div class="mb-3">
                        <label for="logo-url" class="form-label">URL du logo</label>
                        <input type="url" class="form-control" id="logo-url" placeholder="https://example.com/logo.png">
                      </div>
                      <div class="row mb-3">
                        <div class="col-md-6">
                          <label for="primary-color" class="form-label">Couleur primaire</label>
                          <input type="color" class="form-control form-control-color w-100" id="primary-color" value="#4285f4">
                        </div>
                        <div class="col-md-6">
                          <label for="secondary-color" class="form-label">Couleur secondaire</label>
                          <input type="color" class="form-control form-control-color w-100" id="secondary-color" value="#34a853">
                        </div>
                      </div>
                      <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </form>
                  </div>
                </div>
              </div>

              <div class="col-md-6 mb-4">
                <div class="card">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Intégration Google Forms</h5>
                  </div>
                  <div class="card-body">
                    <form id="google-forms-settings-form">
                      <div class="mb-3">
                        <label for="google-script-url" class="form-label">URL du script Google Apps</label>
                        <input type="url" class="form-control" id="google-script-url" placeholder="https://script.google.com/macros/s/...">
                        <div class="form-text">
                          <a href="docs/google-sheet-setup.html" target="_blank" class="text-decoration-none">
                            <i class="fas fa-question-circle"></i> Guide de configuration Google Sheet
                          </a>
                        </div>
                      </div>
                      <div class="mb-3">
                        <label for="google-sheet-url" class="form-label">URL du Google Sheet</label>
                        <input type="url" class="form-control" id="google-sheet-url" placeholder="https://docs.google.com/spreadsheets/d/...">
                        <div class="form-text">URL de la feuille de calcul où les données seront stockées</div>
                      </div>
                      <div class="mb-3">
                        <label for="form-id" class="form-label">ID du formulaire (optionnel)</label>
                        <input type="text" class="form-control" id="form-id" placeholder="1FAIpQLSe...">
                      </div>
                      <div class="mb-3">
                        <label for="sheet-id" class="form-label">ID de la feuille (optionnel)</label>
                        <input type="text" class="form-control" id="sheet-id" placeholder="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2...">
                      </div>
                      <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="offline-support" checked>
                        <label class="form-check-label" for="offline-support">Support hors ligne</label>
                      </div>
                      <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="auto-create-form" checked>
                        <label class="form-check-label" for="auto-create-form">Créer automatiquement le formulaire</label>
                      </div>
                      <div class="d-flex">
                        <button type="submit" class="btn btn-primary me-2">Enregistrer</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="testGoogleFormsConnection()">Tester la connexion</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-4">
                <div class="card">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Paramètres du jeu</h5>
                  </div>
                  <div class="card-body">
                    <form id="game-settings-form">
                      <div class="mb-3">
                        <label for="points-per-question" class="form-label">Points par question</label>
                        <input type="number" class="form-control" id="points-per-question" min="0" value="10">
                      </div>
                      <div class="mb-3">
                        <label for="time-limit" class="form-label">Limite de temps (minutes, 0 = illimité)</label>
                        <input type="number" class="form-control" id="time-limit" min="0" value="0">
                      </div>
                      <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="show-leaderboard" checked>
                        <label class="form-check-label" for="show-leaderboard">Afficher le classement</label>
                      </div>
                      <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="require-login">
                        <label class="form-check-label" for="require-login">Exiger une connexion</label>
                      </div>
                      <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="show-hints" checked>
                        <label class="form-check-label" for="show-hints">Afficher les indices</label>
                      </div>
                      <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="allow-skip">
                        <label class="form-check-label" for="allow-skip">Permettre de sauter des questions</label>
                      </div>
                      <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </form>
                  </div>
                </div>
              </div>

              <div class="col-md-6 mb-4">
                <div class="card">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Gestion des paramètres</h5>
                  </div>
                  <div class="card-body">
                    <div class="d-grid gap-2">
                      <button type="button" class="btn btn-outline-primary" onclick="exportSettings()">
                        <i class="fas fa-file-export me-1"></i> Exporter les paramètres
                      </button>
                      <div class="mb-3">
                        <label for="import-settings" class="form-label">Importer les paramètres</label>
                        <input class="form-control" type="file" id="import-settings" accept=".json" onchange="importSettings(event)">
                      </div>
                      <button type="button" class="btn btn-danger" id="reset-settings">
                        <i class="fas fa-trash me-1"></i> Réinitialiser tous les paramètres
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          {{ ... }}
        </main>
      </div>
    </div>
  </div>

  <!-- Bootstrap Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.js"></script>
  <!-- JSZip for QR code export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.7.1/jszip.min.js"></script>
  <!-- QRCode.js -->
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.0/build/qrcode.min.js"></script>
  
  <!-- Admin Scripts -->
  <script src="js/admin/auth.js"></script>
  <script src="js/admin/main.js"></script>
  <script src="js/admin/dashboard.js"></script>
  <script src="js/admin/questions.js"></script>
  <script src="js/admin/statistics.js"></script>
  <script src="js/admin/export.js"></script>
  <script src="js/admin/settings.js"></script>
</body>
</html>
